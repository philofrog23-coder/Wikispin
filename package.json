{
  "name": "wikispin",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build-pools": "node tools/build-pools.mjs",
    "make-sounds": "node tools/make-sounds.mjs",
    "make-icon": "node tools/make-icon.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "desktop:web": "expo export --platform web --output-dir desktop/web",
    "desktop:start": "npm run desktop:web && electron desktop",
    "desktop:build": "npm run desktop:web && electron-builder --projectDir desktop --win",
    "web:build": "expo export --platform web --output-dir dist"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tools/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
