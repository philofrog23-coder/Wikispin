{
  "name": "wikispin-desktop",
  "productName": "WikiSpin",
  "version": "1.0.0",
  "description": "Spin a roulette and read a random Wikipedia article.",
  "author": "WikiSpin",
  "license": "MIT",
  "main": "main.js",
  "build": {
    "appId": "com.example.wikispin.desktop",
    "productName": "WikiSpin",
    "electronVersion": "45.1.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "icon.png",
      "web/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WikiSpin",
      "artifactName": "WikiSpin-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "WikiSpin-Portable-${version}.${ext}"
    },
    "electronLanguages": [
      "en-US",
      "ru"
    ]
  }
}
